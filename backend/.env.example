REDIS_URL=redis://localhost:6379/0

# Crypto (public streams, no key required)
BINANCE_WS_URL=wss://stream.binance.com:9443/stream
BYBIT_WS_URL=wss://stream.bybit.com/v5/public/linear

# Forex/metals — leave blank to skip that feed
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_BASE_URL=https://api-fxpractice.oanda.com

POLYGON_API_KEY=

# Vision chart parser — leave blank to fall back to OpenCV-only detection.
# vision_provider="anthropic" + ANTHROPIC_API_KEY drives both the level
# detector and the full SMC/Price-Action report (POST /analyze-chart/report).
VISION_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
VISION_MODEL=gpt-4o-mini

MIN_RISK_REWARD=2.0
ATR_PERIOD=14
ATR_STOP_MULTIPLE=1.5

# Position sizing defaults used by /signals and /analyze-chart/report unless
# overridden per-request.
DEFAULT_ACCOUNT_BALANCE=10000.0
DEFAULT_RISK_PCT=0.01

# Alert delivery for POST /signals/notify — leave blank to skip a channel.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# Shared secret TradingView alerts must send back (?secret= or
# X-Webhook-Secret header) to POST /webhook/tradingview. Leave blank only
# for local dev — an empty secret accepts unauthenticated market data.
TRADINGVIEW_WEBHOOK_SECRET=

CORS_ORIGINS=["http://localhost:3000"]
